# MySQL Server config (rondb-docker resources/config_templates/my.cnf, trimmed)
[mysqld]
basedir         = /srv/hops/mysql
datadir         = /srv/hops/mysql-cluster/mysql
port            = 3306
socket          = /srv/hops/mysql-cluster/mysql.sock
bind-address    = 0.0.0.0
pid-file        = /srv/hops/mysql-cluster/log/mysqld.pid
log-error       = /srv/hops/mysql-cluster/log/mysqld.err
tmpdir          = /tmp
max-connections = 512
default-time-zone = "+00:00"
explicit_defaults_for_timestamp = 1

# join the cluster and make NDB the default engine
ndbcluster
default-storage-engine = ndbcluster
ndb-cluster-connection-pool = 1
# push conditions and joins down to the data nodes
optimizer_switch = engine_condition_pushdown=on
ndb-join-pushdown = 1
# no extra row-count scan per query for optimizer estimates (rondb-docker's setting)
ndb-use-exact-count = 0

[mysql_cluster]
ndb-connectstring = mgmd:1186
ndb-wait-setup = 900

[client]
socket = /srv/hops/mysql-cluster/mysql.sock
