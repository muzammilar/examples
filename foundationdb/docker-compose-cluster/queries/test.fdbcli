# one fdbcli session, one command per line (# lines are skipped)
writemode on
# point writes: every `set` outside `begin` auto-commits and prints its commit version
set user/1 alice
set user/2 bob
set user/3 carol
get user/2
get user/9
# keys are kept sorted, so a prefix is a range; the trailing number is a LIMIT
getrange user/ user0 2
# begin ... commit: one serializable transaction over several keys, reads see its own writes
begin
set user/4 dave
clear user/1
get user/4
commit
# rollback discards the buffered writes
begin
set user/5 mallory
rollback
get user/5
getrange user/ user0
getversion
