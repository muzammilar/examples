FROM ubuntu:24.04@sha256:562111b88caa79c71391c0c4d3c2114a7d5c35915c20561fd893cb1e07929e6b
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv
COPY deploy/oracle-requirements.txt /app/oracle-requirements.txt
RUN /opt/venv/bin/pip install --no-cache-dir -r /app/oracle-requirements.txt
COPY deploy/catalog.json /app/catalog.json
COPY lake-oracle/ /app/
ENV AWS_EC2_METADATA_DISABLED=true
ENTRYPOINT ["/opt/venv/bin/python", "/app/verify.py"]
