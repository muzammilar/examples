FROM eclipse-temurin:17-jre-noble@sha256:ad806840ae514b83d3d8e3a00a5c1b7302fb0a6ae02bbbaf8a8bf1ffdf5367c6
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends curl python3 openssh-server openssh-client psmisc netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*
RUN case "$TARGETARCH" in \
      arm64) artifact=hadoop-3.5.0-aarch64.tar.gz; checksum=feaa20fea4709050ee993aae23b05720383a0d65aeda97c68d042e52564e8e77a83196a5a6973abdc690a1e600a73308ade56ccf9baeec231d1cf0810703430f ;; \
      amd64) artifact=hadoop-3.5.0.tar.gz; checksum=04ab94496cc00c8b7a28d03f6308eff8d2a4e7f37a9da5e8e086e4d6fc990e7a94d661908f6a6136039536efb362614b8aecdef185b5fb8ed588f0b152c7aa16 ;; \
      *) exit 1 ;; \
    esac \
    && curl --fail --location --retry 3 "https://downloads.apache.org/hadoop/common/hadoop-3.5.0/$artifact" -o /tmp/hadoop.tar.gz \
    && printf '%s  /tmp/hadoop.tar.gz\n' "$checksum" | sha512sum -c - \
    && mkdir /opt/hadoop && tar -xf /tmp/hadoop.tar.gz --strip-components=1 -C /opt/hadoop \
    && rm /tmp/hadoop.tar.gz \
    && groupadd -g 10000 hadoop && useradd -m -u 10000 -g hadoop hadoop \
    && mkdir -p /data/name /data/data /data/journal /control /lab-ssh /witness /run/sshd \
    && chown -R hadoop:hadoop /data /control /lab-ssh /witness /opt/hadoop \
    && usermod -p "*" hadoop \
    && rm -f /etc/ssh/ssh_host_*
ENV HADOOP_HOME=/opt/hadoop
ENV HADOOP_CONF_DIR=/opt/hadoop/etc/hadoop
ENV PATH=/opt/hadoop/bin:$PATH
ENV HADOOP_HEAPSIZE_MAX=512
ENV HADOOP_PID_DIR=/control
ENV HADOOP_IDENT_STRING=hadoop
ENV LD_LIBRARY_PATH=/opt/hadoop/lib/native:/opt/java/openjdk/lib/server
ENV AWS_EC2_METADATA_DISABLED=true
COPY config/ /opt/hadoop/etc/hadoop/
COPY scripts/start.sh scripts/role_config.py scripts/keys.py scripts/workload-start.sh /opt/hadoop/lab-scripts/
WORKDIR /opt/hadoop
ENTRYPOINT ["bash", "/opt/hadoop/lab-scripts/start.sh"]
