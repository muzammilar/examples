FROM python:3.12.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 AWS_EC2_METADATA_DISABLED=true
WORKDIR /app
COPY requirements.txt audit-requirements.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/requirements.txt -r /tmp/audit-requirements.txt
COPY *.py /app/
RUN python -m unittest -v test_workload test_traffic test_placement test_reader test_multipart
ENTRYPOINT ["python", "/app/workload.py"]
