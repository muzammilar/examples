<clickhouse>
    <allow_experimental_cluster_discovery>1</allow_experimental_cluster_discovery>

    <remote_servers replace="replace">

        <!-- Observer: finds every cluster registered under the root path (cluster_hits, cluster_all_nodes, ...) -->
        <!-- but never registers itself, so it is never a shard or replica. -->
        <!-- multicluster_root_path requires <observer/>; clusters are named after their path segment. -->
        <all_discovered_clusters>
            <discovery>
                <multicluster_root_path>/clickhouse/discovery</multicluster_root_path>
                <observer />
                <secret>cluster_hits_secret</secret>
            </discovery>
        </all_discovered_clusters>

    </remote_servers>
</clickhouse>
