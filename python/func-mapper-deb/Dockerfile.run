# Runtime image for the monitoring demo (`make docker-up`, see docker-compose.yml).
# It pip-installs the package (and prometheus_client from requirements.txt) instead of the .deb,
# so it doesn't need the debian build container. The build container is ./Dockerfile.
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /src
COPY requirements.txt setup.py ./
COPY funcmapper ./funcmapper
ARG PKG_VERSION=0.0.1-0
RUN PKG_VERSION=${PKG_VERSION} pip install . && rm -rf /src/build /src/*.egg-info

WORKDIR /
USER nobody
EXPOSE 8000
CMD ["funk", "--interval", "2", "--metrics-port", "8000"]
