{
  "kind": "Cluster",
  "apiVersion": "kind.x-k8s.io/v1alpha4",
  "name": "kafka-cross-cluster-mirroring",
  "nodes": [
    {
      "role": "control-plane",
      "image": "kindest/node:v1.34.0",
      "extraMounts": [
        {
          "hostPath": "@WITNESS_HOST_PATH@",
          "containerPath": "/var/lab/mirroring"
        }
      ]
    },
    {
      "role": "worker",
      "image": "kindest/node:v1.34.0"
    },
    {
      "role": "worker",
      "image": "kindest/node:v1.34.0"
    },
    {
      "role": "worker",
      "image": "kindest/node:v1.34.0"
    }
  ]
}
