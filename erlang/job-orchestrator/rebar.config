{minimum_otp_vsn, "27"}.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_missing_spec_exported
]}.

{deps, []}.

{project_plugins, [erlfmt, rebar3_lint, rebar3_hank]}.

{erlfmt, [
    write,
    {files, ["{src,test}/*.{erl,app.src}", "scripts/*.escript", "rebar.config"]}
]}.

%% `rebar3 lint`: elvis's standard rules.
{elvis, [
    {config, [
        #{files => ["src/*.erl"], ruleset => erl_files},
        %% A Common Test suite exports one function per test case, and tests
        %% repeat a few lines of setup; only larger repeats count.
        #{
            files => ["test/*.erl"],
            ruleset => erl_files,
            rules => [
                {elvis_style, no_god_modules, disable},
                {elvis_style, dont_repeat_yourself, #{min_complexity => 20}}
            ]
        },
        #{files => ["rebar.config"], ruleset => rebar_config},
        #{files => [".gitignore"], ruleset => gitignore}
    ]}
]}.

%% `rebar3 hank`: dead code. Common Test callbacks must take Config even
%% when they don't use it.
{hank, [
    {ignore, [{"test/*_SUITE.erl", unnecessary_function_arguments}]}
]}.

{dialyzer, [
    {warnings, [unmatched_returns, error_handling, extra_return, missing_return]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{relx, [
    {release, {orchestrator, "0.1.0"}, [orchestrator, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src, "config/vm.args.src"}
]}.

{profiles, [
    {prod, [
        {relx, [{mode, prod}]}
    ]},
    {test, [
        {erl_opts, [nowarn_missing_spec_exported]}
    ]}
]}.
